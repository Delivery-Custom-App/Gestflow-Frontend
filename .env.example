# Variables de entorno del frontend (Vite).
# Copiar a `.env.local` para desarrollo contra GestFlow Backend V2.

# ── Backend V2 (rama integration/backend-v2) ──────────────────────────
# Puerto por defecto del uvicorn V2. CORS V2 ya permite :5173.
VITE_API_URL=http://localhost:8000

# Recetas las sirve el mismo Backend V2 — dejar vacío o igual a VITE_API_URL.
VITE_RECETAS_API_URL=

# Redirección opcional luego del login (path relativo, ej: /admin)
VITE_LOGIN_REDIRECT=

# Proxy de Vite (solo si VITE_API_URL queda vacío y usás /api relativo)
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
