# Variables de entorno del frontend (Vite). Copiar a .env.local para desarrollo
# y definir en el entorno de producción del hosting.

# URL del backend (monolito). Vacío => usa el proxy /api del mismo dominio.
VITE_API_URL=

# URL del microservicio de recetas. OPCIONAL: si está vacía, el cliente de recetas
# usa VITE_API_URL como fallback (las recetas las sirve el mismo monolito). (SEC-04)
VITE_RECETAS_API_URL=

# La base de datos local se configura en .env.db para Docker/Postgres.
# El backend debe usar DATABASE_URL desde .env.db.example.

# Redirección opcional luego del login (path relativo, ej: /admin)
VITE_LOGIN_REDIRECT=
